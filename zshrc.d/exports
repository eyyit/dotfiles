#!/bin/bash

export EDITOR=/usr/bin/vim
export HOSTNAME=$(hostname -f)
export LANG=en_US.UTF-8
export LANGUAGE=${LANG}
export OS_TYPE=$(uname)
unset USERNAME
if [ "${OS_TYPE}" = "Darwin" ]; then
  export LESSCLOSE="lessclose.sh %s %s"
  export LESSOPEN="|lesspipe.sh %s"
else
  if [[ ! -x ${HOME}/.hishtory/hishtory ]] \
     && command -v tmux >/dev/null 2>&1; then
    if echo -e "$(tmux -V | cut -d' ' -f2)\n3.2" | \
         sort -V | \
         tail -1 | \
         grep -q 3.2; then
      export FZF_TMUX=1
    else
      export FZF_TMUX_OPTS="-p 80%,80%"
    fi
    if [[ -n "${ZSH_VERSION:-}" ]]; then
      test -r /usr/share/doc/fzf/examples/key-bindings.zsh && \
        source /usr/share/doc/fzf/examples/key-bindings.zsh
    elif [[ -n "${BASH_VERSION:-}" ]]; then
      test -r /usr/share/doc/fzf/examples/key-bindings.bash && \
        source /usr/share/doc/fzf/examples/key-bindings.bash
    fi
  fi
  [ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"
fi

if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || \
    eval "$(dircolors -b)"
fi
